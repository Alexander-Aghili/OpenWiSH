{"code":"def I(i): return {\"op\":\"input\",\"index\":i}\ndef B(op,l,r): return {\"op\":op,\"left\":l,\"right\":r}\ndef N(a): return {\"op\":\"not\",\"arg\":a}\nA=B(\"and\",I(3),I(4)); Bb=B(\"or\",I(5),I(6)); C=B(\"xor\",I(5),I(8)); D=B(\"xor\",I(6),I(8))\nE=B(\"nor\",I(3),I(4)); F=B(\"and\",I(0),I(7)); G=N(I(8)); H=B(\"nor\",I(4),I(5))\nP=B(\"nor\",A,Bb); Q=B(\"xor\",C,D); R=B(\"nor\",E,F); T=B(\"and\",G,H)\nprog=B(\"xor\",B(\"and\",P,Q),B(\"xor\",R,T))\ndef ev(e,x):\n    o=e[\"op\"]\n    if o==\"input\": return x[e[\"index\"]]\n    if o==\"not\": return 1-ev(e[\"arg\"],x)\n    a,b=ev(e[\"left\"],x),ev(e[\"right\"],x)\n    return {\"and\":a&b,\"or\":a|b,\"xor\":a^b,\"nand\":1-(a&b),\"nor\":1-(a|b)}[o]\nxs=[[(n>>(9-k))&1 for k in range(10)] for n in range(1024)]\nprint(\"P&Q ever 1:\",sum(ev(B(\"and\",P,Q),x) for x in xs), \"ones:\",sum(ev(prog,x) for x in xs))\nsub={\"before_program\":prog,\"after_program\":prog}\nprint(check_submission(sub))\nimport json; json.dump(sub,open(\"/work/submission.json\",\"w\"))\n","error":false,"flags":[],"kind":"python","output":"P&Q ever 1: 0 ones: 608\nok\n","restarted":false,"run":2,"seconds":0.006411859,"turn":2}
