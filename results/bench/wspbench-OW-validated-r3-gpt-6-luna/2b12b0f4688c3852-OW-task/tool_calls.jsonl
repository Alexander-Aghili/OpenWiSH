{"code":"import json\n\ndef inp(i):\n    return {\"op\": \"input\", \"index\": i}\n\ndef unary(op, arg):\n    return {\"op\": op, \"arg\": arg}\n\ndef binary(op, left, right):\n    return {\"op\": op, \"left\": left, \"right\": right}\n\ndef program():\n    not_x8 = unary(\"not\", inp(8))\n    x4_eq_x5 = unary(\"not\", binary(\"xor\", inp(4), inp(5)))\n    x3_eq_x4 = unary(\"not\", binary(\"xor\", inp(3), inp(4)))\n    x0_and_x7 = binary(\"and\", inp(0), inp(7))\n    excluded = unary(\"not\", binary(\"or\", x3_eq_x4, x0_and_x7))\n    return binary(\"and\", binary(\"and\", not_x8, x4_eq_x5), excluded)\n\nsub = {\"before_program\": program(), \"after_program\": program()}\ncheck_submission(sub)\nwith open(\"/work/submission.json\", \"w\") as f:\n    json.dump(sub, f)\n","error":false,"flags":[],"kind":"python","output":"","restarted":false,"run":3,"seconds":0.001084165,"turn":3}
