{"code":"# Weight-only alignment: incoming directions to each MLP and downstream readout.\nfor l in [0,1]:\n    wi=W[f\"blocks.{l}.mlp.W_in\"]; wo=W[f\"blocks.{l}.mlp.W_out\"]\n    read_t=np.linalg.norm(Ec@wi,axis=0)\n    read_p=np.linalg.norm(Pc@wi,axis=0)\n    print(\"\\nMLP\",l, \"input neuron token/position norm correlation\",np.corrcoef(read_t,read_p)[0,1])\n    print(\"input token/position relative quantiles\",np.quantile(read_t/(read_p+1e-8),[0,.1,.25,.5,.75,.9,1]))\n    for target in [\"Q\",\"K\",\"V\"]:\n        mat=W[f\"blocks.2.attn.W_{target}\"][0]\n        strengths=np.linalg.norm(wo@mat,axis=1)\n        inds=np.argsort(strengths)[-12:][::-1]\n        print(\"to L2H0\",target,\"total norm\",np.linalg.norm(wo@mat))\n        print(\"top neurons [index, output strength, token read, position read]\")\n        print(np.array([[j,strengths[j],read_t[j],read_p[j]] for j in inds]))\n    for prev in range(l+1):\n        for h in range(4):\n            ov=W[f\"blocks.{prev}.attn.W_V\"][h]@W[f\"blocks.{prev}.attn.W_O\"][h]\n            print(\"input alignment with head\",prev,h,\"token\",np.linalg.norm(Ec@ov@wi),\"pos\",np.linalg.norm(Pc@ov@wi))\n","error":false,"flags":[],"kind":"python","output":"\nMLP 0 input neuron token/position norm correlation 0.4579172576891588\ninput token/position relative quantiles [0.33 0.5  0.72 0.95 1.26 1.76 2.92]\nto L2H0 Q total norm 3.747849\ntop neurons [index, output strength, token read, position read]\n[[ 76.     0.74   1.01   1.92]\n [ 32.     0.67   0.64   0.95]\n [ 79.     0.65   0.9    1.06]\n [105.     0.63   0.79   1.98]\n [ 47.     0.62   0.76   1.73]\n [112.     0.59   0.69   1.37]\n [ 86.     0.57   1.23   1.01]\n [ 40.     0.53   0.57   1.11]\n [ 92.     0.52   0.71   1.64]\n [ 41.     0.51   0.72   1.47]\n [ 80.     0.49   0.82   1.71]\n [ 88.     0.49   0.73   1.96]]\nto L2H0 K total norm 3.9538329\ntop neurons [index, output strength, token read, position read]\n[[ 99.     0.72   1.75   1.37]\n [101.     0.6    0