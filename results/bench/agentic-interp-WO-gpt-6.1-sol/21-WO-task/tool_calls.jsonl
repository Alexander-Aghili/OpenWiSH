{"code":"# Linear weight-only QK and OV diagnostics. No attention probabilities or activations.\nfor l in [0,1,3]:\n    for h in ([0,1,2,3] if l==0 else [0]):\n        pre=f'blocks.{l}.attn.'\n        Q=W[pre+'W_Q'][h]; K=W[pre+'W_K'][h]\n        V=W[pre+'W_V'][h]; O=W[pre+'W_O'][h]\n        bq=W[pre+'b_Q'][h]; bk=W[pre+'b_K'][h]\n        print('\\nHEAD',l,h)\n        print('token QK', (E@Q+bq)@(E@K+bk).T/np.sqrt(12))\n        print('position QK', (P@Q+bq)@(P@K+bk).T/np.sqrt(12))\n        a,s,b=np.linalg.svd(V@O,full_matrices=False)\n        print('OV singular',s[:6])\n        print('E on top OV reads',E@a[:,:3])\n        print('P on top OV reads',P@a[:,:3])\nfor l in range(4):\n    wi=W[f'blocks.{l}.mlp.W_in']; wo=W[f'blocks.{l}.mlp.W_out']\n    a,s,b=np.linalg.svd(wo,full_matrices=False)\n    print('\\nMLP',l,'top output sv',s[:6])\n    print('output directions to U',b[:4]@U)\n    print('input token preactivations, top output neuron loadings', (E@wi+W[f'blocks.{l}.mlp.b_in'])@a[:,:4])\n    print('in-out linear singular',np.linalg.svd(wi@wo,compute_uv=False)[:8])\n","error":false,"flags":[],"kind":"python","output":"\nHEAD 0 0\ntoken QK [[-0.127  0.016 -0.109  0.142  0.089]\n [ 0.014 -0.007  0.014  0.004 -0.009]\n [ 0.086 -0.044  0.464 -0.327 -0.25 ]\n [ 0.076  0.014 -0.16   0.165 -0.073]\n [ 0.215  0.004 -0.099 -0.079  0.007]]\nposition QK [[ 0.028 -0.04   0.011 -0.014 -0.008  0.     0.004 -0.012  0.006  0.002]\n [ 0.378 -0.298 -0.173 -0.157 -0.151 -0.072 -0.07   0.095  0.131  0.14 ]\n [ 0.362 -0.303 -0.156 -0.161 -0.156 -0.07  -0.063  0.095  0.132  0.144]\n [ 0.286 -0.161 -0.146 -0.096 -0.116 -0.041 -0.067  0.053  0.068  0.081]\n [ 0.145 -0.029 -0.049 -0.027 -0.04   0.006 -0.012  0.001 -0.028 -0.008]\n [ 0.021  0.038  0.02   0.014  0.012  0.002 -0.002 -0.004 -0.016 -0.022]\n [-0.097  0.078  0.041  0.043  0.036  0.019  0.005 -0.011 -0.024 -0.028]\n [-0.29   0.129  0.093  0.069  0.082  0.047  0.098 -0.063 -0.065 -0.042]\n [-0.327  0.115  0.093  0.074  0.09   0.037 