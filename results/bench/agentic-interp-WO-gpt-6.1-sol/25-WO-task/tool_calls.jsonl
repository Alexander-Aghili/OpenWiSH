{"code":"# Only linear weight-space products and decompositions.\nfor h in range(4):\n    p = \"blocks.0.attn.\"\n    Q,K,V,O = [W[p+n][h] for n in [\"W_Q\",\"W_K\",\"W_V\",\"W_O\"]]\n    bq,bk,bv = [W[p+n][h] for n in [\"b_Q\",\"b_K\",\"b_V\"]]\n    print(\"\\nHEAD\", h)\n    q = (E + P[1]) @ Q + bq\n    k = (E + P[1]) @ K + bk\n    print(\"Token scores, position 1:\\n\", q @ k.T / np.sqrt(15))\n    print(\"Score to BOS at position 0:\", q @ ((E[0]+P[0])@K+bk)/np.sqrt(15))\n    vals = (E + P[1]) @ V @ O + bv @ O\n    bos = (E[0]+P[0])@V@O + bv@O\n    print(\"Value norms:\", np.linalg.norm(vals,axis=1), \"BOS\",np.linalg.norm(bos))\n    _,s,vt = np.linalg.svd(np.concatenate([vals,bos[None]]),full_matrices=False)\n    print(\"Value singular values:\", s)\n    print(\"Value coordinates:\\n\", np.concatenate([vals,bos[None]])@vt[:3].T)\n    for l in [0,1]:\n        wi=W[f\"blocks.{l}.mlp.W_in\"]\n        print(\"Value input coupling to MLP\",l,np.linalg.norm(vals@wi,axis=1),\n              \"BOS\",np.linalg.norm(bos@wi))\nfor l in [0,1]:\n    wi,wo=W[f\"blocks.{l}.mlp.W_in\"],W[f\"blocks.{l}.mlp.W_out\"]\n    u,s,vt=np.linalg.svd(wi,full_matrices=False)\n    print(\"\\nMLP\",l,\"input singular values:\",s[:15])\n    print(\"Output singular values:\",np.linalg.svd(wo,compute_uv=False)[:15])\n    print(\"E input norms:\",np.linalg.norm(E@wi,axis=1))\n    print(\"P input norms:\",np.linalg.norm(P@wi,axis=1))\n    print(\"Output to unembed norm:\",np.linalg.norm(wo@W[\"unembed.W_U\"]))\n","error":false,"flags":[],"kind":"python","output":"\nHEAD 0\nToken scores, position 1:\n [[ 0.461 -0.174 -0.416 -0.493 -0.174]\n [ 0.226 -0.206 -0.303 -0.146 -0.669]\n [ 0.872 -0.751  1.136 -1.835 -2.226]\n [ 0.313 -0.722 -1.926  0.901 -3.196]\n [ 0.459 -0.042 -0.545 -0.524  0.576]]\nScore to BOS at position 0: [1.149 0.767 2.291 2.12  0.968]\nValue norms: [19.826  5.003 15.622 16.53  21.657] BOS 33.583477\nValue singular values: [44.459 23.002  5.125  0.521  0.131  0.101]\nValue coordina