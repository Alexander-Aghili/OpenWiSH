{"code":"import json\n\ndef inp(i):\n    return {\"op\":\"input\",\"index\":i}\n\ndef binary(op,a,b):\n    return {\"op\":op,\"left\":a,\"right\":b}\n\n# Algebraic triple identities:\n# (sum-1,0,0) -> AND; (sum,0,sum-1) -> OR;\n# (sum,0,2*sum-2) -> XOR; (1,sum-1,sum) -> NOR.\na = binary(\"and\",inp(3),inp(4))\nb = binary(\"or\",inp(5),inp(6))\nc = binary(\"xor\",inp(5),inp(8))\nd = binary(\"xor\",inp(6),inp(8))\ne = binary(\"nor\",inp(3),inp(4))\nf = binary(\"and\",inp(0),inp(7))\ng = {\"op\":\"not\",\"arg\":inp(8)}\nh = binary(\"nor\",inp(4),inp(5))\np = binary(\"nor\",a,b)\nq = binary(\"xor\",c,d)\nr = binary(\"nor\",e,f)\ns = binary(\"and\",g,h)\nprogram = binary(\"xor\",binary(\"and\",p,q),binary(\"xor\",r,s))\nsub = {\"before_program\":program,\"after_program\":program}\ncheck_submission(sub)\nwith open(\"/work/submission.json\",\"w\") as file:\n    json.dump(sub,file)\n","error":false,"flags":[],"kind":"python","output":"","restarted":false,"run":3,"seconds":0.001043876,"turn":3}
