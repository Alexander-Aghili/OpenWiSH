{"code":"import numpy as np\n\nr2 = np.load('/work/fwd/r2/run.npz')\n\n# Check if L1H0_ATTN write differs between first vs dup - and look at L3H0\n# Input 0: ['BOS','b','b','a','a','b','b','a','a','a']\n# pos1=b(first), pos2=b(dup), pos3=a(first), pos4=a(dup)\n# Input 1: ['BOS','c','c','a','c','a','c','c','a','a']\n# pos1=c(first), pos2=c(dup), pos3=a(first), pos5=a(dup)\n\nwrite_keys = [k for k in sorted(r2.keys()) \n              if k not in ['logits'] and 'pattern' not in k and 'post' not in k]\nprint(\"Write keys:\", write_keys)\nprint()\n\nfor k in write_keys:\n    w = r2[k]\n    print(f\"\\n=== {k} ===\")\n    # Norm at first vs dup positions across inputs\n    # Input 0: pos1(b_first), pos2(b_dup), pos3(a_first), pos4(a_dup)\n    norms0 = np.linalg.norm(w[0], axis=-1)\n    print(f\"Input0 norms: {norms0.round(3)}\")\n    \n    # Cosine between first-occ and dup for same token\n    b1=w[0,1]; b2=w[0,2]; a3=w[0,3]; a4=w[0,4]\n    cb = np.dot(b1,b2)/(np.linalg.norm(b1)*np.linalg.norm(b2)+1e-8)\n    ca = np.dot(a3,a4)/(np.linalg.norm(a3)*np.linalg.norm(a4)+1e-8)\n    print(f\"cos(b_first_inp0, b_dup_inp0)={cb:.3f}  cos(a_first_inp0, a_dup_inp0)={ca:.3f}\")\n    \n    # Input 1: pos1(c_first), pos3(a_first), pos5(a_dup)\n    norms1 = np.linalg.norm(w[1], axis=-1)\n    print(f\"Input1 norms: {norms1.round(3)}\")\n    \n    c1=w[1,1]; a3_1=w[1,3]; a5_1=w[1,5]\n    cc = np.dot(c1,w[1,2])/(np.linalg.norm(c1)*np.linalg.norm(w[1,2])+1e-8)\n    ca1 = np.dot(a3_1,a5_1)/(np.linalg.norm(a3_1)*np.linalg.norm(a5_1)+1e-8)\n    print(f\"cos(c_first_inp1, c_dup_inp1)={cc:.3f}  cos(a_first_inp1, a_dup_inp1)={ca1:.3f}\")\n","error":false,"flags":[],"kind":"python","output":"Write keys: ['L0H0_ATTN', 'L0H1_ATTN', 'L0H2_ATTN', 'L0H3_ATTN', 'L0_MLP', 'L1H0_ATTN', 'L1H1_ATTN', 'L1H2_ATTN', 'L1H3_ATTN', 'L1_MLP', 'L2H0_ATTN', 'L2H1_ATTN', 'L2H2_ATTN', 'L2H3_ATTN', 'L2_MLP', 'L3H0_ATTN', 'L3H1_ATTN', 'L3H2_ATTN', 'L3H3_ATTN', 'L3_MLP']\n\n\n=== L0H0_ATTN ===\nInput0 norms: [ 3.244  5.06