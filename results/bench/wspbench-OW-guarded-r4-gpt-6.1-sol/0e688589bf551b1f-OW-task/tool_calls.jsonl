{"code":"import json\n\n# Coefficient identities decode layer 0 as:\n# xor(x7,x7), or(x6,x7), and(x6,x7), and(x1,x9),\n# nor(x6,x7), or(x7,x9), xor(x0,x4), nand(x3,x8).\n# Layer 1: nand, and, xor, nand on consecutive pairs.\n# Layer 2: and, then or (before) / and (after).\n# Layer 3 selects the first branch when x6 is true.\n# Simplify each mux branch under its condition, purely symbolically.\n\ndef inp(i):\n    return {\"op\": \"input\", \"index\": i}\n\ndef binary(op, a, b):\n    return {\"op\": op, \"left\": a, \"right\": b}\n\ndef neg(a):\n    return {\"op\": \"not\", \"arg\": a}\n\nthen_branch = binary(\"and\", inp(7), binary(\"and\", inp(1), inp(9)))\nk_false = binary(\"or\", inp(7), neg(inp(9)))\nl_branch = binary(\n    \"or\",\n    neg(binary(\"xor\", inp(0), inp(4))),\n    binary(\"and\", inp(3), inp(8))\n)\n\ndef program(op):\n    return {\n        \"op\": \"mux\",\n        \"condition\": inp(6),\n        \"then\": then_branch,\n        \"else\": binary(op, k_false, l_branch)\n    }\n\nsub = {\"before_program\": program(\"or\"), \"after_program\": program(\"and\")}\ncheck_submission(sub)\nwith open(\"/work/submission.json\", \"w\") as f:\n    json.dump(sub, f)\n","error":false,"flags":[],"kind":"python","output":"","restarted":false,"run":2,"seconds":0.000701475,"turn":2}
