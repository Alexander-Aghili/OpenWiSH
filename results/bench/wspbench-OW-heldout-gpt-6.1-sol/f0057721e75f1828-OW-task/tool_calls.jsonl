{"code":"import json\n\ndef inp(i):\n    return {\"op\": \"input\", \"index\": i}\n\ndef gate(op, left, right):\n    return {\"op\": op, \"left\": left, \"right\": right}\n\n# Coefficient identities for each encoded triple:\n# OR: R(s)-R(s-1); XOR: R(s)-R(2*s-2);\n# NOR: 1+R(s-1)-R(s); NAND: 1-R(s-1); AND: R(s-1).\na = gate(\"or\", inp(8), inp(9))\nb = gate(\"xor\", inp(1), inp(4))\nc = gate(\"nor\", inp(3), inp(5))\nd = gate(\"nand\", inp(0), inp(3))\ne = gate(\"and\", inp(5), inp(6))\nf = gate(\"or\", inp(2), inp(8))\ng = gate(\"nand\", inp(6), inp(8))\nh = gate(\"nor\", inp(4), inp(8))\n\ni = gate(\"and\", a, b)\nk = gate(\"nor\", e, f)\nl = gate(\"nor\", g, h)\nn = gate(\"nand\", k, l)\n\ndef program(edited):\n    j = gate(\"and\" if edited else \"or\", c, d)\n    m = gate(\"and\", i, j)\n    return gate(\"nand\", m, n)\n\nsub = {\"before_program\": program(False), \"after_program\": program(True)}\ncheck_submission(sub)\nwith open(\"/work/submission.json\", \"w\") as file:\n    json.dump(sub, file)\n","error":false,"flags":[],"kind":"python","output":"","restarted":false,"run":2,"seconds":0.001775606,"turn":2}
